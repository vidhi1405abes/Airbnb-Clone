{
  "$schema": "https://json.schemastore.org/claude-settings.json",
  "project": {
    "name": "airbnb-clone",
    "description": "Production-grade pixel-perfect Airbnb listing clone with React 18, Node.js Express, and distributed vacation-rental architecture.",
    "version": "1.0.0"
  },
  "environment": {
    "node": ">=18.0.0",
    "packageManager": "npm"
  },
  "devCommands": {
    "start": "npm run dev",
    "build": "npm run build",
    "clientDev": "cd client && npm run dev",
    "serverDev": "cd server && npm run dev"
  },
  "aiWorkflow": {
    "orchestrator": "SDLC Orchestrator (README.md)",
    "agents": [
      "research-and-requirements",
      "developer",
      "tester"
    ],
    "phases": [
      "Phase 0: Setup",
      "Phase 1: Research (Gate 1)",
      "Phase 2: Development Plan (Gate 2)",
      "Phase 3: Build",
      "Phase 4: Test Plan (Gate 3)",
      "Phase 5: Test Run",
      "Phase 6: Fix",
      "Phase 7: Showcase (Gate 4)",
      "Phase 8: Deliver"
    ]
  }
}
